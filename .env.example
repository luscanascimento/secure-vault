# ============================================================================
# Secure Vault — Environment Variables
# Copy this file to `.env` and replace every placeholder with a real value.
# NEVER commit a real `.env` file. All values below are SAFE PLACEHOLDERS.
# Generate strong secrets with, e.g.:  openssl rand -base64 48
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000

# --- Web origin (CORS allow-list) ------------------------------------------
# The single browser origin allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:4200

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=vault
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=securevault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (assembled from the pieces above).
# Inside docker compose, POSTGRES_HOST becomes the service name `postgres`.
DATABASE_URL=postgresql://vault:change_me_postgres_password@localhost:5432/securevault?schema=public

# --- Password hashing (Argon2id) -------------------------------------------
# Application-level pepper mixed in BEFORE hashing (defense in depth on top of
# argon2's per-user random salt). Must be long & random. Rotating it invalidates
# all existing password hashes, so treat as a long-lived secret.
PASSWORD_PEPPER=change_me_at_least_32_chars_random_pepper_value

# --- JWT -------------------------------------------------------------------
# Separate secrets for access and refresh tokens.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
# Short-lived access token; longer-lived rotating refresh token.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Encryption at rest (AES-256-GCM) --------------------------------------
# 32-byte key, base64-encoded (44 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# See the README "Key Management & Rotation" section before changing this.
NOTE_ENCRYPTION_KEY=change_me_base64_encoded_32_byte_key_here======

# --- Cookies / CSRF --------------------------------------------------------
# `true` in production (HTTPS) so cookies get the Secure flag.
COOKIE_SECURE=false
# Name of the refresh-token cookie.
REFRESH_COOKIE_NAME=sv_refresh
# Name of the CSRF cookie (double-submit token).
CSRF_COOKIE_NAME=sv_csrf

# --- Rate limiting (global @nestjs/throttler defaults) ----------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Password strength scoring (guardsvc, optional) ------------------------
# Base URL of the guardsvc scorer. Leave empty to turn the check off.
# With `docker compose --profile guardsvc up` the service name is `guardsvc`:
#   GUARDSVC_URL=http://guardsvc:8080
# The call is advisory: on timeout, error or an empty URL, registration
# continues on the DTO's own rules.
GUARDSVC_URL=
GUARDSVC_TIMEOUT_MS=400

# --- Frontend build-time config (apps/web) ---------------------------------
# Base URL the Angular app uses to reach the API.
API_BASE_URL=http://localhost:3000
